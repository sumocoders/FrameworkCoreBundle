{
  "name": "sumocoders/framework-core-bundle",
  "type": "symfony-bundle",
  "description": "The core bundle for our mini-framework",
  "keywords": ["Symfony", "SumoCoders"],
  "license": "MIT",
  "authors": [
    {
      "name": "Tijs Verkoyen",
      "email": "tijs@sumocoders.be"
    },
    {
      "name": "Bruno Vitorino",
      "email": "bruno@sumocoders.be"
    },
    {
      "name": "Sander De la Marche",
      "email": "sander@sumocoders.be"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "knplabs/knp-menu-bundle": "^3.4",
    "symfony/form": "^8.2",
    "symfony/asset": "^8.2",
    "symfony/console": "^8.2",
    "symfony/security-bundle": "^8.2",
    "symfony/translation": "^8.2",
    "symfony/twig-bundle": "^8.2",
    "twig/inky-extra": "^3.16",
    "twig/cssinliner-extra": "^3.16",
    "twig/extra-bundle": "^3.16",
    "symfony/ux-autocomplete": "^3.0",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/orm": "^3.3",
    "symfony/doctrine-messenger": "^8.2",
    "symfony/intl": "^8.2",
    "nelmio/security-bundle": "^3.7",
    "symfony/validator": "^8.2",
    "symfony/http-client": "^8.2",
    "symfony/asset-mapper": "^8.2",
    "symfony/string": "^8.2",
    "symfony/ux-live-component": "^3.5",
    "melbahja/seo": "^3.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master",
    "symfony/maker-bundle": "^1.61",
    "carthage-software/mago": "^1.43",
    "squizlabs/php_codesniffer": "^4.0",
    "phpstan/phpstan": "^2.2",
    "vincentlanglet/twig-cs-fixer": "^4.0",
    "micheh/phpcs-gitlab": "^2.1",
    "phpunit/phpunit": "^13.0",
    "sentry/sentry-symfony": "^5.13"
  },
  "suggest": {
    "sentry/sentry-symfony": "Enables the sentry_user_context feature: attaches the authenticated (and, when impersonated, impersonator) user identifier to the Sentry scope."
  },
  "autoload": {
    "psr-4": {
      "SumoCoders\\FrameworkCoreBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SumoCoders\\FrameworkCoreBundle\\Tests\\": "tests/"
    }
  }
}
